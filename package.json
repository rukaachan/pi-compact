{
  "name": "@rukaachan/pi-compact",
  "version": "0.1.0",
  "private": true,
  "description": "Compact, semantic tool rows for Pi coding agent.",
  "keywords": [
    "compact",
    "pi",
    "pi-extension",
    "pi-package",
    "tui",
    "ui"
  ],
  "license": "MIT",
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:coverage": "node scripts/test-coverage.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.19.19",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <2",
    "@earendil-works/pi-tui": ">=1.4.0 <2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
